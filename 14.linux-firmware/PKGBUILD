pkgbase=linux-firmware
pkgname=('linux-firmware' 'linux-firmware-other' 'amd-ucode' 'linux-firmware-amdgpu' 'linux-firmware-realtek')
pkgver=20261019
pkgrel=2
pkgdesc="Firmware files for Linux"
arch=(any)
makedepends=('git' 'parallel' 'python' 'rdfind')
source=("git+https://gitlab.com/kernel-firmware/linux-firmware.git#tag=${pkgver}")
sha512sums=('SKIP')

build() {
  mkdir -p kernel/x86/microcode
  cat linux-firmware/amd-ucode/microcode_amd*.bin > kernel/x86/microcode/AuthenticAMD.bin

  if [[ -n ${SOURCE_DATE_EPOCH} ]]; then
    touch -d @${SOURCE_DATE_EPOCH} kernel/x86/microcode/AuthenticAMD.bin
  fi

  echo kernel/x86/microcode/AuthenticAMD.bin |
    bsdtar --uid 0 --gid 0 -cnf - -T - |
    bsdtar --null -cf - --format=newc @- > amd-ucode.img
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#${pkgdir}/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_linux-firmware() {
  pkgdesc+=" - Default set"
  depends=('amd-ucode' 'linux-firmware-amdgpu' 'linux-firmware-realtek')
}

package_linux-firmware-other() {
  pkgdesc+=" - Unsorted firmware for various devices"
  local fwdir="${pkgdir}/usr/lib/firmware"
  ZSTD_CLEVEL=19 make -C linux-firmware FIRMWAREDIR="${fwdir}" install-zst

  _pick amd-ucode "${fwdir}"/amd-ucode
  _pick amdgpu "${fwdir}"/amdgpu
  _pick realtek "${fwdir}"/{realtek,rtlwifi,rtw8*,rtl_*}

  rm -rf "${fwdir}"/amd{,npu,tee}
  rm -rf "${fwdir}"/{ar[0-9]*,ath*,carl9170*,htc_*,qca,wil6210*}
  rm -rf "${fwdir}"/{bnx2*,brcm,cypress,tigon}
  rm -rf "${fwdir}"/{cirrus,cs42l43*,sdca}
  rm -rf "${fwdir}"/{e100,hfi1_*,i915,intel,isci,iwlwifi*,ixp4xx,qat_*,xe}
  rm -rf "${fwdir}"/*/ish
  rm -rf "${fwdir}"/liquidio
  rm -rf "${fwdir}"/{libertas,mwl8k,mwlwifi,mrvl}
  rm -rf "${fwdir}"/{mediatek,mt7*,rt[237]*}
  rm -rf "${fwdir}"/mellanox
  rm -rf "${fwdir}"/netronome
  rm -rf "${fwdir}"/nvidia
  rm -rf "${fwdir}"/{qcom,a300_*}
  rm -rf "${fwdir}"/{qlogic,qed,ql2???_*,c{b,t,t2}fw-*}
  rm -rf "${fwdir}"/radeon
  rm -rf "${fwdir}"/{ti_*,ti,ti-connectivity,tas*,INT8*,TAS2*,TI*,TX*,????-*-0x?.*}
  rm -rf linux-firmware/LICENSES

  make -C linux-firmware FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup
}

package_amd-ucode() {
  pkgdesc="Microcode update image for AMD CPUs"
  mv -v ${pkgname}/* "${pkgdir}"
  make -C linux-firmware FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup
  install -Dm644 amd-ucode.img -t "${pkgdir}/boot"
}

package_linux-firmware-amdgpu() {
  pkgdesc+=" - Firmware for AMD Radeon GPUs"
  mv -v ${pkgname#linux-firmware-}/* "${pkgdir}"
  make -C linux-firmware FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup
}

package_linux-firmware-realtek() {
  pkgdesc+=" - Firmware for Realtek devices"
  mv -v ${pkgname#linux-firmware-}/* "${pkgdir}"
  make -C linux-firmware FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup
}