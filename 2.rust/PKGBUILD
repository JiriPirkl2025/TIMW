_llvmver=23.1.5
pkgname=('rust' 'rust-src')
pkgver=1.99.1
pkgrel=3
pkgdesc="Systems programming language focused on safety, speed and concurrency"
arch=('x86_64')
depends=('bash' 'compiler-rt' 'curl' 'gcc' 'glibc' 'libgcc' 'libgit2' 'libssh2' 'libstdc++' 'lld' 'llvm-libs' 'openssl' 'sqlite' 'zlib')
makedepends=("clang=$_llvmver" "llvm=$_llvmver" 'cmake' 'libffi' 'ninja' 'perl' 'python' 'rust')
source=("https://static.rust-lang.org/dist/rustc-$pkgver-src.tar.xz" "https://github.com/llvm/llvm-project/releases/download/llvmorg-$_llvmver/llvm-project-$_llvmver.src.tar.xz" 0001-bootstrap-Change-libexec-dir.patch 0002-bootstrap-Change-bash-completion-dir.patch 0003-bootstrap-Workaround-for-system-stage0.patch 0004-compiler-Change-LLVM-targets.patch 0005-compiler-Use-ld.lld-by-default.patch 0006-compiler-Use-target-specific-GCC-linkers.patch 0007-compiler-Link-riscv64-musl-statically.patch 0008-compiler-Swap-primary-and-secondary-lib-dirs.patch)
sha512sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd rustc-$pkgver-src

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  rm -rf src/llvm-project
  ln -sr "$srcdir/llvm-project-$_llvmver.src" src/llvm-project

  cat >bootstrap.toml <<END
profile = "dist"
change-id = 160100

[llvm]
download-ci-llvm = false
link-shared = true
targets = "AMDGPU;X86"

[gcc]
download-ci-gcc = false

[build]
description = "%description%"
target = ["x86_64-unknown-linux-gnu",]
cargo = "$HOME/.cargo/bin/cargo"
rustc = "$HOME/.cargo/bin/rustc"
rustfmt = "$HOME/.cargo/bin/rustfmt"
locked-deps = true
vendor = true
tools = ["cargo", "clippy", "rustfmt", "src",]
profiler = true
sanitizers = false
docs = false

[install]
prefix = "/usr"

[rust]
codegen-units = 1
codegen-units-std = 1
debuginfo-level = 0
debuginfo-level-std = 0
channel = "stable"
rpath = false
frame-pointers = true
lld = false
bootstrap-override-lld = "external"
llvm-bitcode-linker = false
deny-warnings = false
lto = "thin"
parallel-frontend-threads = 0

[dist]
compression-formats = ["gz"]
compression-profile = "fast"

[target.x86_64-unknown-linux-gnu]
llvm-config = "/usr/bin/llvm-config"
optimized-compiler-builtins = "/usr/lib/clang/23/lib/x86_64-pc-linux-gnu/libclang_rt.builtins.a"
END
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

build() {
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- --default-toolchain stable -y --no-modify-path
  cd rustc-$pkgver-src
  DESTDIR="$srcdir/dest-rust" python ./x.py install -j "$(nproc)"
  cd ../dest-rust

  rm -v etc/target-spec-json-schema.json
  rm -v usr/lib/rustlib/{components,install.log,rust-installer-version,uninstall.sh}
  rm -v usr/lib/rustlib/manifest-*

  ln -srvft usr/lib usr/lib/rustlib/x86_64-unknown-linux-gnu/lib/*.so

  mkdir -pv usr/lib/rustlib/x86_64-unknown-linux-gnu/bin/gcc-ld
  ln -srvf  usr/bin/lld          usr/lib/rustlib/x86_64-unknown-linux-gnu/bin/rust-lld
  ln -srvf  usr/bin/llvm-objcopy usr/lib/rustlib/x86_64-unknown-linux-gnu/bin/rust-objcopy
  ln -srvft usr/lib/rustlib/x86_64-unknown-linux-gnu/bin/gcc-ld usr/bin/{ld.lld,ld64.lld,lld-link,wasm-ld}
  _pick dest-src  usr/lib/rustlib/src
}

package_rust() {
  depends+=('libcurl.so' 'libgcc_s.so' 'libgit2.so' 'libsqlite3.so' 'libssh2.so' 'libssl.so')
  provides=('cargo' 'rustfmt')
  conflicts=('cargo' 'rust-docs<1:1.56.1-3' 'rustfmt')
  cp -a dest-rust/* "$pkgdir"
}

package_rust-src() {
  pkgdesc="Source code for the Rust standard library"
  depends=('rust')
  cp -a dest-src/* "$pkgdir"
}
