pkgname=spirv-llvm-translator
pkgver=23.1.3
pkgrel=2
pkgdesc="LLVM <-> SPIR-V converter for compilers targeting SPIR-V"
arch=('x86_64')
depends=('glibc' 'libstdc++' 'llvm-libs' 'spirv-tools')
makedepends=('cmake' 'git' 'llvm' 'ninja' 'spirv-headers')
source=("git+https://github.com/KhronosGroup/SPIRV-LLVM-Translator#tag=v$pkgver")
sha512sums=('SKIP')

build() {
  local cmake_options=(
    -DBUILD_SHARED_LIBS=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_SYSCONFDIR=/etc
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    -DCMAKE_SKIP_RPATH=ON
    -DLLVM_CONFIG=llvm-config
    -DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr/include/spirv
    -DLLVM_LIBDIR_SUFFIX=
    -DLLVM_SPIRV_ENABLE_LIBSPIRV_DIS=ON
    -DLLVM_SPIRV_INCLUDE_TESTS=OFF
    -Wno-author
  )

  cmake -S SPIRV-LLVM-Translator -B build -G Ninja "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
