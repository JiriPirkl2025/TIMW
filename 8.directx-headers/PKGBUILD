pkgname=directx-headers
pkgver=1.721.2
pkgrel=2
pkgdesc="DirectX headers for using D3D12"
arch=('x86_64')
makedepends=('git' 'meson')
source=("directx-headers::git+https://github.com/microsoft/DirectX-Headers#tag=v$pkgver")
sha512sums=('SKIP')

build() {
  local meson_options=(
    --prefix=/usr
    --libexecdir=lib
    --sbindir=bin
    --buildtype=release
    --auto-features=enabled
    --wrap-mode=nodownload
    -D build-test=false
  )

  meson setup directx-headers build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}